{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "version",
    "models",
    "session",
    "gates"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "models": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "session": {
      "type": "object",
      "required": [
        "timeoutSeconds",
        "maxOutputTokens"
      ],
      "properties": {
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 7200
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1
        },
        "maxPremiumRequests": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "default": null,
          "description": "Optional local ceiling for the sum of SDK cost multipliers. null or omitted disables this ceiling. This is not account quota or currency."
        },
        "permissions": {
          "type": "string",
          "enum": [
            "bypass",
            "ask"
          ],
          "default": "bypass",
          "description": "bypass automatically approves SDK permissions and project tool commands; ask uses interactive confirmations."
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "command"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "cwd": {
            "type": "string"
          },
          "timeoutSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          }
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agentsByStatus": {
          "type": "object",
          "description": "Roles allowed per task status, without sdlc- prefix. First available role is the default action. Missing statuses use built-in defaults; [] disables agents for that status.",
          "additionalProperties": false,
          "properties": {
            "ready": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,62}$"
              }
            },
            "active": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,62}$"
              }
            },
            "review": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,62}$"
              }
            },
            "changes": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,62}$"
              }
            },
            "blocked": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,62}$"
              }
            },
            "accepted": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,62}$"
              }
            },
            "closed": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,62}$"
              }
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$",
          "maxLength": 100,
          "default": "copilot-sdk"
        },
        "roles": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_-]{0,62}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$",
            "maxLength": 100
          }
        },
        "options": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$",
            "maxLength": 100
          },
          "additionalProperties": {
            "type": "object"
          }
        }
      }
    }
  }
}
